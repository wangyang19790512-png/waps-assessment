# DeepSeek API key (required for AI agent analysis)
DEEPSEEK_API_KEY=sk-...

# Redis connection URL (optional — falls back to JSON file storage)
# REDIS_URL=redis://localhost:6379

# API server port (default: 3001)
PORT=3001

# Frontend dev proxy target (only needed during development)
# VITE_API_URL=http://localhost:3001
